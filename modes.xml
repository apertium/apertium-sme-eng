<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <!-- sme → eng -->

  <mode name="sme-eng" install="yes" gendebug="yes">
    <pipeline>

      <program name="hfst-proc -w -e">
	<file name="sme-eng.automorf.hfst"/>
      </program>
      <program name="cg-proc -w">
        <file name="sme-eng.mor.rlx.bin"/>
      </program>
      <program name="cg-proc -n -1 -w">
        <file name="sme-eng.syn.rlx.bin"/>
      </program>
      <program name="apertium-pretransfer"/>
      <program name="lt-proc -b">
        <file name="sme-eng.autobil.bin"/>
      </program>
      <program name="lrx-proc -m">
        <file name="sme-eng.autolex.bin"/>
      </program>
      <program name="rtx-proc">
        <file name="sme-eng.rtx.bin"/>
      </program>
      <program name="lt-proc $1">
        <file name="sme-eng.autogen.bin"/>
      </program>
      <program name="lt-proc -p">
        <file name="sme-eng.autopgen.bin"/>
      </program>
    </pipeline>
  </mode>

  <!-- eng → sme -->

  <mode name="eng-sme" install="yes" gendebug="yes">
    <pipeline>

      <program name="lt-proc -w">
        <file name="eng-sme.automorf.bin"/>
      </program>


      <program name="cg-proc -w">
        <file name="eng-sme.rlx.bin"/>
      </program>
      <program name="apertium-tagger -g $2">
        <file name="eng-sme.prob"/>
      </program>

      <program name="apertium-pretransfer"/>
      <program name="lt-proc -b">
        <file name="eng-sme.autobil.bin"/>
      </program>
      <program name="lrx-proc -m">
        <file name="eng-sme.autolex.bin"/>
      </program>


      <program name="rtx-proc">
        <file name="eng-sme.rtx.bin"/>
      </program>

      <program name="hfst-proc $1">
	<file name="eng-sme.autogen.hfst"/>
      </program>
    </pipeline>
  </mode>
</modes>

