    <e><i>Øverland<s n="np"/></i></e>
    <e><i>Øysten<s n="np"/></i></e>

    <!-- nouns -->

    <e><p><l>viessu<s n="n"/></l><r>house<s n="n"/></r></p></e>

    <!-- verbs -->

    <e><p><l>leat<s n="vblex"/></l><r>be<s n="vbser"/></r></p></e>
    <e><p><l>leat<s n="vblex"/></l><r>have<s n="vbhaver"/></r></p></e>


    <!-- puncts -->
    <e><re>[.\?;:!…¿¶]</re><p><l><s n="sent"/></l><r><s n="sent"/></r></p></e>
    <e><re>,</re>          <p><l><s n="cm"/></l>  <r><s n="cm"/></r></p></e>
  </section>
</dictionary>

