    <e><i>Wenche<s n="np"/></i></e>
    <e><i>Westerfjell<s n="np"/></i></e>
    <e><i>West<s n="np"/></i></e>
    <e><i>Westen<s n="np"/></i></e>
    <e><i>Western<s n="np"/></i></e>
    <e><i>Wexelsen<s n="np"/></i></e>
    <e><i>WGIP<s n="np"/></i></e>
    <e><i>Widerøe<s n="np"/></i></e>
    <e><i>Wigelius<s n="np"/></i></e>
    <e><i>Wikimedia<s n="np"/></i></e>
    <e><i>Wilbur<s n="np"/></i></e>
    <e><i>Wilhelm<s n="np"/></i></e>
    <e><i>Wilhelmsen<s n="np"/></i></e>
    <e><i>Willy<s n="np"/></i></e>
    <e><i>Windows<s n="np"/></i></e>
    <e><i>Winter<s n="np"/></i></e>
    <e><i>WINHEC<s n="np"/></i></e>
    <e><i>WIPO<s n="np"/></i></e>
    <e><i>Wirkola<s n="np"/></i></e>
    <e><i>Wisborg<s n="np"/></i></e>
    <e><i>Wollmann<s n="np"/></i></e>
    <e><i>World<s n="np"/></i></e>
    <e><i>WP1<s n="np"/></i></e>
    <e><i>WWF<s n="np"/></i></e>
    <e><i>XIII<s n="np"/></i></e>
    <e><i>XM<s n="np"/></i></e>
    <e><i>XVI<s n="np"/></i></e>
    <e><i>XVII<s n="np"/></i></e>
    <e><i>Yakutia<s n="np"/></i></e>
    <e><i>Yangon<s n="np"/></i></e>
    <e><i>Yle<s n="np"/></i></e>
    <e><i>YLE<s n="np"/></i></e>
    <e><i>Ylikoski<s n="np"/></i></e>
    <e><i>Ylva<s n="np"/></i></e>
    <e><i>Youth<b/>Yindi<s n="np"/></i></e>
    <e><i>Youth<s n="np"/></i></e>
    <e><i>Zapoljarnyj<s n="np"/></i></e>
    <e><i>ZERO<s n="np"/></i></e>
    <e><i>Zoya<s n="np"/></i></e>
    <e><i>Ådne<s n="np"/></i></e>
    <e><i>Åfjord<s n="np"/></i></e>
    <e><i>Åhren<s n="np"/></i></e>
    <e><i>Åknes<s n="np"/></i></e>
    <e><i>Ålesund<s n="np"/></i></e>
    <e><i>Åre<s n="np"/></i></e>
    <e><i>Årøya<s n="np"/></i></e>
    <e><i>Åsa<s n="np"/></i></e>
    <e><i>Åse<s n="np"/></i></e>
    <e><i>Åserud<s n="np"/></i></e>
    <e><i>Åsli<s n="np"/></i></e>
    <e><i>Ødegård<s n="np"/></i></e>
    <e><i>ØFAS<s n="np"/></i></e>
    <e><i>Øien<s n="np"/></i></e>
    <e><i>Øistein<s n="np"/></i></e>
